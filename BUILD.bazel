load("@rules_python//python:defs.bzl", "py_library")

# Tombstone cogames package. The wheel ships only an `__init__.py` that
# emits a DeprecationWarning. No imports, no consumers in the workspace —
# this target exists so `bazel query //packages/cogames/...` resolves and
# the package can still be built into a wheel by the release workflow.
py_library(
    name = "cogames",
    srcs = glob(["src/cogames/*.py"]),
    imports = ["src"],
    visibility = ["//visibility:public"],
)
